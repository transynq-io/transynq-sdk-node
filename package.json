{
  "name": "@transynq/sdk",
  "version": "1.0.2",
  "description": "Official Node.js / TypeScript SDK for Transynq TMS, the transport management system for carriers, fleet operators, 3PLs, brokers and shippers: bookings, dispatch, live tracking, driver POD, invoicing and costing through the Transynq API.",
  "license": "MIT",
  "author": {
    "name": "Transynq",
    "email": "contact@transynq.io",
    "url": "https://transynq.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transynq-io/transynq-sdk-node.git"
  },
  "homepage": "https://transynq.io/transport-management-system",
  "bugs": {
    "url": "https://github.com/transynq-io/transynq-sdk-node/issues"
  },
  "keywords": [
    "transynq",
    "tms",
    "transport-management-system",
    "transport-management-software",
    "transport",
    "logistics",
    "freight",
    "trucking",
    "fleet-management",
    "dispatch",
    "3pl",
    "proof-of-delivery",
    "shipment-tracking",
    "api-client",
    "sdk",
    "nodejs",
    "typescript",
    "javascript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "docs": "typedoc",
    "examples": "tsc -p examples/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run examples",
    "example": "tsx examples/flows.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "msw": "^2.6.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
